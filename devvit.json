{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "urubu-vegas",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "menu": {
    "items": [
      {
        "label": "Create Urubu Vegas post",
        "description": "Create a playable Urubu Vegas custom post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Urubu Vegas telemetry",
        "description": "Show visitor and recent-player telemetry",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/telemetry"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "urubu_vegas_dev"
  }
}
